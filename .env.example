# MAPI keys, one per product. A wrong key still reports "connected",
# so never swap them.
MIDAS_MAPI_KEY_GEN=
MIDAS_MAPI_KEY_CIVIL=

# Request timeout in seconds. Short on purpose: a modal dialog in NX
# blocks the session, and a short timeout surfaces that quickly.
MIDAS_TIMEOUT=20

# Most rows/records one tool call returns; the rest are counted, not sent.
MIDAS_MAX_ROWS=200

# run_analysis only: a big model takes minutes to solve.
MIDAS_ANALYSIS_TIMEOUT=300

# save_copy only: writing a big model takes a while.
MIDAS_SAVE_TIMEOUT=120

# Folder NX writes captures into. Must exist on the PC running NX (and, to
# read the image back, that must be this PC).
MIDAS_OUTPUT_DIR=C:/temp
